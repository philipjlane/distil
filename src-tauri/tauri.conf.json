{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Distil",
  "version": "0.1.0",
  "identifier": "com.philipjlane.distil",
  "build": {
    "beforeDevCommand": "npm run build:capture && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:capture && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Distil",
        "width": 720,
        "height": 560,
        "minWidth": 560,
        "minHeight": 420,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/distil-capture"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
